# Pulse configuration. For local development copy this file to .env.local;
# on Vercel add the same variables under Project -> Settings -> Environment Variables.
# Never commit real values. Full walkthrough: docs/SETUP.md

# --- Required --------------------------------------------------------------

# The password you sign in with. Use something long and unique: anyone with it can see your health data.
APP_PASSWORD=

# Postgres connection string. Free Neon database: https://neon.tech
# (adding Neon from the Vercel Storage tab fills this in for you; leave its variable prefix blank)
DATABASE_URL=

# Google Cloud OAuth client of type "Web application" with the Google Health API enabled.
# Redirect URI: https://<your-app>/api/oauth/callback   (see docs/SETUP.md, step 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string, e.g. from: openssl rand -hex 32
# Vercel sends it with the scheduled jobs (daily sync, bedtime reminder); without it they are refused.
CRON_SECRET=

# --- Optional --------------------------------------------------------------

# Your time zone (IANA name). Used for day boundaries, bedtimes and notification text. Default: America/New_York
# PULSE_TZ=America/Los_Angeles

# AI coach + daily briefing. Free key, no credit card: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Notifications go through ntfy.sh using a private topic Pulse generates itself. Override only if you want to:
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# Link opened when a notification is tapped (defaults to your Vercel production URL):
# APP_URL=https://your-app.vercel.app

# Show made-up demo data with no login, database or Google account.
# Only for a separate public demo deployment, never for the one holding your real data.
# Locally you can just run: npm run demo
# DEMO_MODE=true
