# Copy to .env.local (local dev) and add the same values in Vercel -> Settings -> Environment Variables.

# Password you sign in with (long + unique: anyone with it can see your health data)
APP_PASSWORD=
# Free Neon Postgres: https://neon.tech (or add it from the Vercel Marketplace)
DATABASE_URL=
# Google Cloud OAuth client (type: Web application) with the Google Health API enabled. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lets Vercel Cron sync once a day. Any long random string.
CRON_SECRET=
# Optional: AI coach + daily briefing. Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: your timezone for day boundaries and bedtimes (default America/New_York)
# PULSE_TZ=America/Los_Angeles
# Optional: notifications go through ntfy.sh with a private topic Pulse generates itself. Override only if you want to:
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# APP_URL=https://your-app.vercel.app
# Show made-up data with no login or database (only for a separate public demo deployment)
# DEMO_MODE=true
