# Copy to .env.local (local dev) and add the same values in Vercel -> Settings -> Environment Variables.

# Password you sign in with (long + unique: anyone with it can see your health data)
APP_PASSWORD=
# Free Neon Postgres: https://neon.tech (or add it from the Vercel Marketplace)
DATABASE_URL=
# Google Cloud OAuth client (type: Web application) with the Google Health API enabled. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lets Vercel Cron sync once a day. Any long random string.
CRON_SECRET=
# Show made-up data with no login or database (only for a separate public demo deployment)
# DEMO_MODE=true
